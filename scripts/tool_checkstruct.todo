# Open findings, one line per rule and file: <rule> <count> <path>.
#
# This is a to-do list, not a permission: the count is a ratchet, so one
# finding more than listed fails the hook, and one less fails too, asking for
# the number to come down. Delete the line once the file is clean.
#
# Per project, and deliberately not a policy file: "make documentation" copies
# tool_checkstruct.py from LIBXS and would revert a count lowered here.
# Regenerate with: scripts/tool_checkstruct.py --counts $(git ls-files)
# ozaki_opencl.c is being edited right now, so the two tree-wide rules that
# reach it are deferred rather than scrubbed under a live change.
blank-in-function   1  samples/ozaki/ozaki_opencl.c
stacked-comments    5  samples/ozaki/ozaki_opencl.c
# section-order is new, and both entries predate it. libxstream.h puts a
# callback type above the entry point that takes it, which the policy allows;
# the CRT kernel interleaves its constant tables and a compile-time assertion
# with the functions that read them.
section-order       1  libxstream/libxstream.h
section-order       7  samples/ozaki/kernels/ozaki2_int8.cl
